# Same-host, four-worker performance profile.
# Load these values into the actual process manager; this file contains no secrets.
DASH_WEB_WORKERS=4
DASH_WEB_THREADS=1
DASH_WEB_TIMEOUT=180
DASH_BIND_HOST=127.0.0.1
DASHBOARD_SNAPSHOT_LOCAL_PERSISTENCE_ENABLED=1
DASHBOARD_SNAPSHOT_MEMORY_MAX_BYTES=134217728
DASHBOARD_SNAPSHOT_DISK_MAX_BYTES=2147483648
DASH_DB_POOL_SIZE=2
DASH_DB_MAX_OVERFLOW=0
DASH_DB_APPLICATION_NAME=dash_shipping_lng_snd
# Roll out these switches sequentially, restarting all workers at each step.
# The Fleet precompute command prepares v2 artifacts without enabling traffic.
DASH_REVISION_AWARE_REFRESH_ENABLED=0
DASH_FLEET_ARROW_SOURCE_ENABLED=0
DASH_FLEET_RENDER_SNAPSHOT_ENABLED=0
DASH_FLEET_STAGED_RENDER_ENABLED=0
